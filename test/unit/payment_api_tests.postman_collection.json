      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "booking_id",
              "value": "105",
              "type": "text"
            },
            {
              "key": "action",
              "value": "pay",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/booking_history.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking_history.php"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code trả về hợp lệ (200 OK hoặc 302 Redirect)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
