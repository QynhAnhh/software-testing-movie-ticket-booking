{
  "info": {
    "_postman_id": "b93f4321-821c-401d-b31c-testing-booking",
    "name": "Booking API Tests",
    "description": "Collection test API/Form Data cho kịch bản đặt vé (TC-OI-08)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-OI-08: Thiếu mảng ghế seat_ids khi đặt vé",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "showtime_id",
              "value": "300",
              "type": "text"
            },
            {
              "key": "payment_method",
              "value": "momo",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/booking.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking.php"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Backend xử lý chặn đặt vé rỗng (200/302)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/PROJECT_CLEAN",
      "type": "string"
