      "name": "[TC-AH-01] Đăng ký hợp lệ (13 ký tự)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"[TC-AH-01] Đăng ký hợp lệ (13 ký tự)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('success');",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('sharedEmail', 'test_shared_' + Date.now() + '@test.com');",
              "pm.collectionVariables.set('sharedPhone', '090' + Math.floor(1000000 + Math.random() * 9000000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"first_name\": \"Nguyễn\",\n    \"last_name\": \"A\",\n    \"email\": \"{{sharedEmail}}\",\n    \"phone\": \"{{sharedPhone}}\",\n    \"password\": \"abcdfhgjtghtg\",\n    \"confirm_password\": \"abcdfhgjtghtg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth.php?action=register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth.php"
          ],
          "query": [
            {
              "key": "action",
              "value": "register"
            }
          ]
        }
      }
    },
