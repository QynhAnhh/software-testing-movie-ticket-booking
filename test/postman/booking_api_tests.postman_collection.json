{
  "info": {
    "_postman_id": "booking-api-tests-collection-id",
    "name": "Booking API Tests (TC-OI-01, 03, 04, 05, 08)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-OI-01: Tạo Booking mới (Status Pending)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movie_id\": 1,\n  \"showtime_id\": 1,\n  \"seat_ids\": [1, 2],\n  \"user_id\": 1\n}"
        },
        "url": {
          "raw": "http://localhost/software-testing-movie-ticket-booking/backend/api/booking.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["software-testing-movie-ticket-booking", "backend", "api", "booking.php"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200/201', function () { pm.response.to.have.status(200); });",
              "pm.test('Booking created with Pending status', function () { var jsonData = pm.response.json(); pm.expect(jsonData.status).to.eql('pending'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TC-OI-03: Hủy đặt vé thủ công (Pending -> Canceled)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 1,\n  \"action\": \"cancel\",\n  \"user_id\": 1\n}"
        },
        "url": {
          "raw": "http://localhost/software-testing-movie-ticket-booking/backend/api/booking.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["software-testing-movie-ticket-booking", "backend", "api", "booking.php"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Booking canceled successfully', function () { var jsonData = pm.response.json(); pm.expect(jsonData.status).to.eql('canceled'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TC-OI-04: Timeout tự động hủy đơn Pending sau 10 phút",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/software-testing-movie-ticket-booking/backend/api/cron_timeout.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["software-testing-movie-ticket-booking", "backend", "api", "cron_timeout.php"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cron timeout executed', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TC-OI-05: Xem lịch sử đặt vé",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/software-testing-movie-ticket-booking/backend/api/booking_history.php?user_id=1",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["software-testing-movie-ticket-booking", "backend", "api", "booking_history.php"],
          "query": [{ "key": "user_id", "value": "1" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get history successfully', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TC-OI-08: Thiếu seat_ids khi đặt vé",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movie_id\": 1,\n  \"showtime_id\": 1,\n  \"seat_ids\": [],\n  \"user_id\": 1\n}"
        },
        "url": {
          "raw": "http://localhost/software-testing-movie-ticket-booking/backend/api/booking.php",
          "protocol": "http",
          "host": ["localhost"],
          "path": ["software-testing-movie-ticket-booking", "backend", "api", "booking.php"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}